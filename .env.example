# `mock` e permitido apenas para desenvolvimento local. Qualquer outro valor
# usa Supabase para os dados e Firebase somente para autenticacao.
EXPO_PUBLIC_DATA_SOURCE=supabase

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_ADS_WEB_ENABLED=false

EXPO_PUBLIC_ADSENSE_CLIENT_ID=
EXPO_PUBLIC_ADSENSE_SLOT_BANNER=
EXPO_PUBLIC_ADSENSE_SLOT_TOOLS_AFTER_RESULT=
EXPO_PUBLIC_ADSENSE_SLOT_TOOLS_HUB_AFTER_CARDS=

# Fallbacks legados; nao usar em configuracoes novas:
# EXPO_PUBLIC_SUPABASE_KEY=
# EXPO_PUBLIC_ENABLE_ADS=

# Web Push (avisos no celular). A publica vai no bundle e pode ser commitada;
# a privada fica so nos secrets do Supabase, nunca aqui.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
