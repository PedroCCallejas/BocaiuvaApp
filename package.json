{
  "name": "appboca",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@11.2.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./tests/run-tests.ts",
    "test:watch": "node --watch --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./tests/run-tests.ts",
    "repair:players-linked-email:dry": "node --no-warnings --experimental-strip-types ./scripts/repair-players-linked-email.ts --dry-run",
    "repair:players-linked-email": "node --no-warnings --experimental-strip-types ./scripts/repair-players-linked-email.ts",
    "audit:membership-index": "node --no-warnings --experimental-strip-types ./scripts/audit-membership-index.ts",
    "audit:player-stats": "node --no-warnings --experimental-strip-types ./scripts/audit-player-stats.ts",
    "audit:finish-permission": "node --no-warnings --experimental-strip-types ./scripts/audit-finish-match-permission.ts",
    "backfill:membership-index:dry": "node --no-warnings --experimental-strip-types ./scripts/backfill-team-membership-index.ts --dry-run",
    "backfill:membership-index": "node --no-warnings --experimental-strip-types ./scripts/backfill-team-membership-index.ts",
    "auth:claim:dry": "node --no-warnings --experimental-strip-types ./scripts/definir-claim-supabase.ts --dry-run",
    "auth:claim": "node --no-warnings --experimental-strip-types ./scripts/definir-claim-supabase.ts",
    "migrar:conferir": "node --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./scripts/conferir-migracao.ts",
    "migrar:baixar": "node --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./scripts/migrar-para-postgres.ts --dry-run --salvar-em=dados-firestore",
    "migrar:preflight": "node --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./scripts/migrar-para-postgres.ts --dry-run --ler-de=dados-firestore",
    "migrar:postgres:dry": "node --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./scripts/migrar-para-postgres.ts --dry-run",
    "migrar:postgres": "node --no-warnings --experimental-strip-types --loader ./tests/alias-loader.mjs ./scripts/migrar-para-postgres.ts"
  },
  "dependencies": {
    "@expo/log-box": "55.0.13",
    "@hookform/resolvers": "^5.2.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "firebase": "^12.12.1",
    "html2canvas": "1.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "firebase-admin": "^13.10.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
